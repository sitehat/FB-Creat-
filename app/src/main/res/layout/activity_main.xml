<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- নেটিভ ভাসমান কন্টেইনার (ফেসবুকের ওপরে সবসময় দৃশ্যমান থাকবে) -->
    <FrameLayout
        android:id="@+id/nativeFloatingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:visibility="gone"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/nativeToggleBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:elevation="10dp" />

            <LinearLayout
                android:id="@+id/nativeToolsMenu"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FAFAFA"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnProfile"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="#EFF6FF"
                    android:text="🔗 Profile"
                    android:textColor="#1D4ED8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn2FA"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="#EEF2FF"
                    android:text="🔑 2FA"
                    android:textColor="#4338CA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCookies"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="#FEF3C7"
                    android:text="🍪 Cookies"
                    android:textColor="#B45309"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCode"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="#ECFDF5"
                    android:text="📥 Code"
                    android:textColor="#047857"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClearData"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#FEF2F2"
                    android:text="🧹 Clear Data"
                    android:textColor="#DC2626"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
